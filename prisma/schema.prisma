// Prisma Schema for Pharmacy Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User and Authentication
model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String   @unique
  password      String
  role          String   @default("admin") // admin, staff, salesman
  fullName      String
  phone         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sales         Sale[]
  purchases     Purchase[]
  payments      Payment[]
  expenses      Expense[]
  activities    ActivityLog[]
}

// Medicine and Inventory
model Medicine {
  id                String   @id @default(cuid())
  name              String
  genericName       String?
  category          String
  manufacturer      String?
  description       String?
  unitType          String   // tablet, capsule, syrup, injection, etc.
  reorderLevel      Int      @default(10)
  barcode           String?  @unique
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  batches           MedicineBatch[]
  saleItems         SaleItem[]
  purchaseItems     PurchaseItem[]

  @@index([name])
  @@index([category])
}

model MedicineBatch {
  id            String   @id @default(cuid())
  medicineId    String
  batchNumber   String
  expiryDate    DateTime
  quantity      Int
  purchasePrice Decimal  @db.Decimal(10, 2)
  salePrice     Decimal  @db.Decimal(10, 2)
  mrp           Decimal  @db.Decimal(10, 2)
  supplierId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  medicine      Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([medicineId])
  @@index([expiryDate])
}

// Suppliers
model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String
  email         String?
  address       String?
  city          String?
  totalPurchase Decimal  @db.Decimal(12, 2) @default(0)
  totalPaid     Decimal  @db.Decimal(12, 2) @default(0)
  dueAmount     Decimal  @db.Decimal(12, 2) @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  purchases     Purchase[]
  batches       MedicineBatch[]
  payments      Payment[]

  @@index([name])
}

// Purchases
model Purchase {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  supplierId    String
  purchaseDate  DateTime @default(now())
  subtotal      Decimal  @db.Decimal(12, 2)
  tax           Decimal  @db.Decimal(10, 2) @default(0)
  discount      Decimal  @db.Decimal(10, 2) @default(0)
  totalAmount   Decimal  @db.Decimal(12, 2)
  paidAmount    Decimal  @db.Decimal(12, 2) @default(0)
  dueAmount     Decimal  @db.Decimal(12, 2)
  paymentStatus String   @default("pending") // pending, partial, paid
  notes         String?
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  user          User @relation(fields: [userId], references: [id])
  items         PurchaseItem[]
  payments      Payment[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@index([invoiceNumber])
}

model PurchaseItem {
  id            String   @id @default(cuid())
  purchaseId    String
  medicineId    String
  batchNumber   String
  expiryDate    DateTime
  quantity      Int
  purchasePrice Decimal  @db.Decimal(10, 2)
  salePrice     Decimal  @db.Decimal(10, 2)
  mrp           Decimal  @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  // Relations
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine      Medicine @relation(fields: [medicineId], references: [id])

  @@index([purchaseId])
  @@index([medicineId])
}

// Customers
model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  email         String?
  address       String?
  city          String?
  creditLimit   Decimal  @db.Decimal(12, 2) @default(0)
  totalSales    Decimal  @db.Decimal(12, 2) @default(0)
  totalPaid     Decimal  @db.Decimal(12, 2) @default(0)
  dueAmount     Decimal  @db.Decimal(12, 2) @default(0)
  loyaltyPoints Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sales         Sale[]
  payments      Payment[]

  @@index([name])
  @@index([phone])
}

// Sales
model Sale {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  customerId    String?
  saleDate      DateTime @default(now())
  subtotal      Decimal  @db.Decimal(12, 2)
  tax           Decimal  @db.Decimal(10, 2) @default(0)
  discount      Decimal  @db.Decimal(10, 2) @default(0)
  totalAmount   Decimal  @db.Decimal(12, 2)
  paidAmount    Decimal  @db.Decimal(12, 2) @default(0)
  dueAmount     Decimal  @db.Decimal(12, 2) @default(0)
  paymentStatus String   @default("paid") // paid, partial, pending
  paymentMethod String   @default("cash") // cash, card, online, credit
  notes         String?
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user          User @relation(fields: [userId], references: [id])
  items         SaleItem[]
  payments      Payment[]

  @@index([customerId])
  @@index([saleDate])
  @@index([invoiceNumber])
}

model SaleItem {
  id            String   @id @default(cuid())
  saleId        String
  medicineId    String
  batchNumber   String?
  quantity      Int
  salePrice     Decimal  @db.Decimal(10, 2)
  mrp           Decimal  @db.Decimal(10, 2)
  discount      Decimal  @db.Decimal(10, 2) @default(0)
  total         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  // Relations
  sale          Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine      Medicine @relation(fields: [medicineId], references: [id])

  @@index([saleId])
  @@index([medicineId])
}

// Distributors (Sales Representatives)
model Distributor {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  email         String?
  address       String?
  city          String?
  area          String?
  totalSales    Decimal  @db.Decimal(12, 2) @default(0)
  totalExpenses Decimal  @db.Decimal(12, 2) @default(0)
  totalProfit   Decimal  @db.Decimal(12, 2) @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sales         DistributorSale[]
  expenses      DistributorExpense[]

  @@index([name])
}

model DistributorSale {
  id            String   @id @default(cuid())
  distributorId String
  saleDate      DateTime @default(now())
  amount        Decimal  @db.Decimal(12, 2)
  cost          Decimal  @db.Decimal(12, 2)
  profit        Decimal  @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now())

  // Relations
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([distributorId])
  @@index([saleDate])
}

model DistributorExpense {
  id            String   @id @default(cuid())
  distributorId String
  expenseDate   DateTime @default(now())
  category      String
  amount        Decimal  @db.Decimal(12, 2)
  description   String?
  createdAt     DateTime @default(now())

  // Relations
  distributor   Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([distributorId])
  @@index([expenseDate])
}

// Payments
model Payment {
  id            String   @id @default(cuid())
  paymentDate   DateTime @default(now())
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String   // cash, bank, online, card
  paymentType   String   // customer, supplier
  referenceId   String?  // Sale ID or Purchase ID
  customerId    String?
  supplierId    String?
  saleId        String?
  purchaseId    String?
  notes         String?
  userId        String
  createdAt     DateTime @default(now())

  // Relations
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  sale          Sale? @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase      Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  user          User @relation(fields: [userId], references: [id])

  @@index([paymentDate])
  @@index([paymentType])
}

// Expenses
model Expense {
  id            String   @id @default(cuid())
  expenseDate   DateTime @default(now())
  category      String   // rent, salary, electricity, fuel, etc.
  amount        Decimal  @db.Decimal(12, 2)
  description   String?
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user          User @relation(fields: [userId], references: [id])

  @@index([expenseDate])
  @@index([category])
}

// System Settings
model Setting {
  id            String   @id @default(cuid())
  key           String   @unique
  value         String
  description   String?
  updatedAt     DateTime @updatedAt
}

// Activity Log
model ActivityLog {
  id            String   @id @default(cuid())
  userId        String
  action        String
  module        String
  description   String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  // Relations
  user          User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
